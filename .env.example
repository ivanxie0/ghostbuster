# Copy to .env at the repo root (cp .env.example .env). NEVER commit .env.

# Neon Postgres connection string (postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=
# true = in-memory simulated run, no DB/keys needed. Set false to use Neon + real modules.
FAKE_MODE=true
# FAKE_MODE only: true = auto-start simulated calls ~10s after a search (curl testing); false = wait for consent / POST /verify
FAKE_AUTO_VERIFY=false
# FAKE_MODE only: B = nobody meets the deadline (packet), A = one provider available in time
FAKE_ENDING=B

# Bright Data API token (Web Unlocker / Scraping Browser)
BRIGHTDATA_API_TOKEN=
# Bright Data zone name to use for requests
BRIGHTDATA_ZONE=
# Bright Data SERP API zone name (optional; ghost check uses it to find a provider's public profile)
BRIGHTDATA_SERP_ZONE=

# Gemini API key for transcript date extraction
GEMINI_API_KEY=

# ElevenLabs API key
ELEVENLABS_API_KEY=
# ElevenLabs Conversational AI agent id
ELEVENLABS_AGENT_ID=
# ElevenLabs id of the Twilio number imported into ElevenLabs (needed by the outbound-call API)
ELEVENLABS_PHONE_NUMBER_ID=

# Twilio account SID (trial)
TWILIO_ACCOUNT_SID=
# Twilio auth token
TWILIO_AUTH_TOKEN=
# Twilio phone number calls come from (E.164, e.g. +16195550000)
TWILIO_PHONE_NUMBER=

# The ONLY numbers the AI agent may call (verified teammate phones, E.164)
TEAMMATE_PHONE_1=
TEAMMATE_PHONE_2=
TEAMMATE_PHONE_3=

# Public URL of the backend for ElevenLabs webhooks (e.g. your ngrok https URL)
PUBLIC_BASE_URL=

# Frontend: backend base URL (also put in frontend/.env.local if running next separately)
NEXT_PUBLIC_API_URL=http://localhost:8000
